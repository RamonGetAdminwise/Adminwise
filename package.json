{
  "name": "adminwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "tsx scripts/dev-db.ts",
    "check:ai": "tsx scripts/check-ai.ts",
    "check:drive": "tsx scripts/check-drive.ts",
    "check:pdf": "tsx scripts/check-pdf.ts",
    "check:quotes": "tsx scripts/check-quotes.ts",
    "check:invoices": "tsx scripts/check-invoices.ts",
    "check:setup": "tsx scripts/check-setup.ts",
    "check:security": "tsx scripts/check-security.ts",
    "check:stripe": "tsx scripts/check-stripe.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "dev:web": "pnpm --filter @adminwise/web dev",
    "dev:worker": "pnpm --filter @adminwise/worker dev",
    "db:migrate": "pnpm --filter @adminwise/db migrate",
    "build:web": "pnpm --filter @adminwise/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.14.0",
    "exceljs": "^4.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
