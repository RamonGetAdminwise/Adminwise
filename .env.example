# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is git-ignored: real secrets never go into the repository.
# In production (Railway or any server) set the same names as environment variables.

# ---- App ----------------------------------------------------------------------
# Product name, shown in the UI and in emails.
APP_NAME=Adminwise
# Public address of the web app, no trailing slash.
# Locally: http://localhost:3000   Production: https://app.getadminwise.com
APP_BASE_URL=http://localhost:3000
# Domain of the forwarding addresses: customers get <slug>@INBOUND_DOMAIN.
INBOUND_DOMAIN=in.getadminwise.com
# Sender of our own mail (sign-in links, drafts emailed back, daily brief).
# The domain is verified in Postmark (DKIM + Return-Path).
MAIL_FROM=Adminwise <hello@getadminwise.com>
# Two-letter code of the EU country our own invoices are issued from. A customer in another
# EU country with a valid VAT number is reverse-charged; one in this country never is.
SELLER_COUNTRY=PL

# ---- Billing ------------------------------------------------------------------
# Leave empty until paid plans are live: every account then has every feature.
# "true" switches on the 14-day trial, the plan limits and read-only accounts.
BILLING_ENABLED=

# ---- Database -----------------------------------------------------------------
# Postgres connection string. The value below matches docker-compose.yml.
# Without Docker: run "pnpm dev:db" and use the URL it prints.
DATABASE_URL=postgres://adminwise:adminwise@localhost:5432/adminwise

# ---- Encryption of mailbox tokens at rest ---------------------------------------
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key locally and in production. Losing or changing a key means
# every customer on that installation must reconnect their mailbox.
TOKEN_ENCRYPTION_KEY=

# ---- AI: Claude through AWS Bedrock (EU) ----------------------------------------
# Region the requests are sent from. Frankfurt.
AWS_REGION=eu-central-1
# One model per task. These are EU inference profiles ("eu." prefix): processing
# stays in the EU. Never use a "global." id here; the app refuses to start with one.
# Writing: reply drafts, voice profile, later quotes. Claude Sonnet 4.6.
BEDROCK_MODEL_DRAFT=eu.anthropic.claude-sonnet-4-6
# Sorting incoming mail. Claude Haiku 4.5.
BEDROCK_MODEL_CLASSIFY=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# When AWS enables Claude Sonnet 5 on the account, switch drafts with this one line
# (check the exact id in the Bedrock model catalog first):
# BEDROCK_MODEL_DRAFT=eu.anthropic.claude-sonnet-5
# Access key of the IAM user "adminwise-bedrock", which may only invoke Claude models
# (docs/ACCOUNTS_SETUP.md, part 1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Microsoft 365 connection (see docs/MICROSOFT_SETUP.md) ----------------------
# "Application (client) ID" of the Entra app registration "Adminwise".
MS_CLIENT_ID=
# Client secret VALUE of that app registration (not the Secret ID). Note its expiry date.
MS_CLIENT_SECRET=
# "common" lets any Microsoft 365 organisation connect. Use a tenant id to restrict to one.
MS_TENANT=common

# ---- Postmark (forwarding addresses and our outgoing mail) ----------------------
# Server API token of the Postmark server. Leave empty locally if you do not want
# real mail sent: mail is then printed to the console instead.
POSTMARK_SERVER_TOKEN=
# A long random password you invent (letters and digits only, 40 characters).
# Postmark sends it with every inbound webhook call:
#   https://postmark:<this value>@app.getadminwise.com/api/webhooks/postmark
POSTMARK_INBOUND_SECRET=

# ---- Worker ---------------------------------------------------------------------
# How many emails the worker processes at the same time.
WORKER_CONCURRENCY=5

# ---- Operator alerts ------------------------------------------------------------
# Where the service tells its operator that something broke: job crashes, model or
# Microsoft errors, a stuck queue. At most one summary per hour, and only when
# something went wrong. The mail holds customer ids, job names, error types and
# counts; never email text, subjects or file names. Empty = no alerts.
ALERT_EMAIL=
