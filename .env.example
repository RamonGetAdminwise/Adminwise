# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is git-ignored: real secrets never go into the repository.
# In production (Railway or any server) set the same names as environment variables.

# ---- App ----------------------------------------------------------------------
# Working product name, shown in the UI and in emails. Placeholder until the name is chosen.
APP_NAME=Backoffice
# Public address of the web app, no trailing slash. Locally: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Domain of the forwarding addresses: customers get <slug>@INBOUND_DOMAIN. Placeholder for now.
INBOUND_DOMAIN=in.backoffice.example
# Sender of our own mail (sign-in links, drafts emailed back, daily brief).
# Must be a sender signature / domain verified in Postmark.
MAIL_FROM=Backoffice <hello@backoffice.example>

# ---- Database -----------------------------------------------------------------
# Postgres connection string. The value below matches docker-compose.yml.
# Without Docker: run "pnpm dev:db" and use the URL it prints.
DATABASE_URL=postgres://backoffice:backoffice@localhost:5432/backoffice

# ---- Encryption of mailbox tokens at rest ---------------------------------------
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key means every customer must reconnect their mailbox.
TOKEN_ENCRYPTION_KEY=

# ---- AI: Claude through AWS Bedrock (EU) ----------------------------------------
# Region where the model runs. Frankfurt keeps processing in the EU.
AWS_REGION=eu-central-1
# Bedrock model id. Cheaper options if drafts are good enough: anthropic.claude-sonnet-5-5,
# anthropic.claude-haiku-5-5. Check in the Bedrock console that the model is enabled in AWS_REGION.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Access key of an IAM user that may only invoke Bedrock models (see docs/ACCOUNTS_SETUP.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Microsoft 365 connection (see docs/MICROSOFT_SETUP.md) ----------------------
# "Application (client) ID" of the Entra app registration.
MS_CLIENT_ID=
# Client secret value of that app registration (expires: note the date).
MS_CLIENT_SECRET=
# "common" lets any Microsoft 365 organisation connect. Use a tenant id to restrict to one.
MS_TENANT=common

# ---- Postmark (forwarding addresses and our outgoing mail) ----------------------
# Server API token. Leave empty locally: mail is then printed to the console instead of sent.
POSTMARK_SERVER_TOKEN=
# A long random password you invent. Postmark sends it with every inbound webhook call:
#   https://postmark:<this value>@<your domain>/api/webhooks/postmark
POSTMARK_INBOUND_SECRET=

# ---- Worker ---------------------------------------------------------------------
# How many emails the worker processes at the same time.
WORKER_CONCURRENCY=5
