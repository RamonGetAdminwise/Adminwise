# The worker (background jobs). Build context: repository root.
FROM node:26-slim
RUN npm install -g pnpm@12.18.0
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/mail/package.json packages/mail/
COPY packages/ai/package.json packages/ai/
COPY packages/offers/package.json packages/offers/
RUN pnpm install --frozen-lockfile

# Headless Chromium prints offers and order confirmations to PDF. Installed with
# the system libraries and fonts it needs, in a fixed place inside the image.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pnpm --filter @adminwise/worker exec playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV NODE_ENV=production
# The worker applies pending migrations itself on start.
CMD ["pnpm", "--filter", "@adminwise/worker", "start"]
